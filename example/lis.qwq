        (([q])_(#q)) ~
        lowerBound ~
        update

process : [q]_q -> [q]_q => newTails_dec

run : [q]_q -> [q]_q => readCondition @ process

initialState : q -> [q]_q => ($) ~ (makeTails_q)

answer : [q]_q -> q =>
        getRunTable ~
        (([q])_9223372036854775807) ~
        lowerBound ~
        foundPosition

main : o -> q =>
        #q ~
        initialState ~
        run ~
        answer

