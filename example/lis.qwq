        (belowCondition ? setLow) ~
        (
                rangeCondition ?
                (notBelowCondition ? setHigh)
        )

search : [q]_q_(q_q) -> [q]_q_(q_q) => rangeCondition @ searchStep

tailsLength : [q]_q -> q => (([q])_(q : o)) ~ []

initialBounds : [q]_q -> q_q => (o_0)_tailsLength

initialSearch : [q]_q -> [q]_q_(q_q) => ($) ~ (([q]_q)_initialBounds)

searchResult : [q]_q_(q_q) -> [q]_q_q => ($) ~ (getLeft_getLow)

lowerBound : [q]_q -> [q]_q_q =>
        initialSearch ~
        search ~
        searchResult

foundArray : [q]_q_q -> [q] => (([q]_q)_(q : o)) ~ (([q])_(q : o))

foundPosition : [q]_q_q -> q => (([q]_q) : o)_q

foundValue : [q]_q_q -> q => (([q]_q)_(q : o)) ~ (([q] : o)_q)

