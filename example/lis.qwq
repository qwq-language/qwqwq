isBelow : [q]_q_(q_q) -> a =>
        ($) ~
        (probeInput_getX) ~
        readAndX ~
        ((q_q) < a)

notBelow : [q]_q_(q_q) -> a => isBelow ~ !

inRange : [q]_q_(q_q) -> a =>
        ($) ~
        (getLow_getHigh) ~
        ((q_q) < a)

belowCondition : [q]_q_(q_q) -> a_([q]_q_(q_q)) => ($) ~ (isBelow_([q]_q_(q_q)))

