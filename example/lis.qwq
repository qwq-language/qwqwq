// an example program by AI

halve : q -> q => (q _ 2) ~ ((q _ q) / q)

makeTails : q -> [q] => (q _ 9223372036854775807) ~ ((q _ q){}[q])

dec : q -> q => (q _ 1) ~ ((q _ q) - q)

getRunTable : [q] _ q -> [q] => ([q]) _ (q : o)

getRunCount : [q] _ q -> q => ([q] : o) _ q

hasRun : [q] _ q -> a =>
	getRunCount ~
	(q _ 0) ~
	((q _ q) > a)

readCondition : [q] _ q -> a _ ([q] _ q) => ($) ~ (hasRun _ ([q] _ q))

// Search state: ((tails, x), (lo, hi)); hi is exclusive.
getLeft : [q] _ q _ (q _ q) -> [q] _ q => ([q] _ q) _ ((q _ q) : o)

getRight : [q] _ q _ (q _ q) -> q _ q => (([q] _ q) : o) _ (q _ q)

getTails : [q] _ q _ (q _ q) -> [q] => getLeft ~ (([q]) _ (q : o))

getX : [q] _ q _ (q _ q) -> q => getLeft ~ (([q] : o) _ q)

getLow : [q] _ q _ (q _ q) -> q => getRight ~ (q _ (q : o))

getHigh : [q] _ q _ (q _ q) -> q => getRight ~ ((q : o) _ q)

mid : [q] _ q _ (q _ q) -> q =>
	($) ~
	(getLow _ getHigh) ~
	((q _ q) + q) ~
	halve

probeInput : [q] _ q _ (q _ q) -> [q] _ q => ($) ~ (getTails _ mid)

readAndX : [q] _ q _ q -> q _ q => [] _ q

isBelow : [q] _ q _ (q _ q) -> a =>
	($) ~
	(probeInput _ getX) ~
	readAndX ~
	((q _ q) < a)

notBelow : [q] _ q _ (q _ q) -> a => isBelow ~ !

inRange : [q] _ q _ (q _ q) -> a =>
	($) ~
	(getLow _ getHigh) ~
	((q _ q) < a)

belowCondition : [q] _ q _ (q _ q) -> a _ ([q] _ q _ (q _ q)) => ($) ~ (isBelow _ ([q] _ q _ (q _ q)))

notBelowCondition : [q] _ q _ (q _ q) -> a _ ([q] _ q _ (q _ q)) => ($) ~ (notBelow _ ([q] _ q _ (q _ q)))

rangeCondition : [q] _ q _ (q _ q) -> a _ ([q] _ q _ (q _ q)) => ($) ~ (inRange _ ([q] _ q _ (q _ q)))

midPlusOne : [q] _ q _ (q _ q) -> q =>
	mid ~
	(q _ 1) ~
	((q _ q) + q)

boundsAfterLow : [q] _ q _ (q _ q) -> q _ q => ($) ~ (midPlusOne _ getHigh)

boundsAfterHigh : [q] _ q _ (q _ q) -> q _ q => ($) ~ (getLow _ mid)

setLow : [q] _ q _ (q _ q) -> [q] _ q _ (q _ q) => ($) ~ (getLeft _ boundsAfterLow)

setHigh : [q] _ q _ (q _ q) -> [q] _ q _ (q _ q) => ($) ~ (getLeft _ boundsAfterHigh)

searchStep : [q] _ q _ (q _ q) -> [q] _ q _ (q _ q) =>
	(belowCondition ? setLow) ~
	(
		rangeCondition ?
		(notBelowCondition ? setHigh)
	)

search : [q] _ q _ (q _ q) -> [q] _ q _ (q _ q) => rangeCondition @ searchStep

tailsLength : [q] _ q -> q => (([q]) _ (q : o)) ~ []

initialBounds : [q] _ q -> q _ q => (o _ 0) _ tailsLength

initialSearch : [q] _ q -> [q] _ q _ (q _ q) => ($) ~ (([q] _ q) _ initialBounds)

searchResult : [q] _ q _ (q _ q) -> [q] _ q _ q => ($) ~ (getLeft _ getLow)

lowerBound : [q] _ q -> [q] _ q _ q =>
	initialSearch ~
	search ~
	searchResult

foundArray : [q] _ q _ q -> [q] => (([q] _ q) _ (q : o)) ~ (([q]) _ (q : o))

foundPosition : [q] _ q _ q -> q => (([q] _ q) : o) _ q

foundValue : [q] _ q _ q -> q => (([q] _ q) _ (q : o)) ~ (([q] : o) _ q)

writeTriple : [q] _ q _ q -> [q] _ q _ q =>
	($) ~
	($ _ ([q] _ q _ q)) ~
	(foundArray _ foundPosition _ foundValue)

update : [q] _ q _ q -> [q] => writeTriple ~ []

newTails : [q] -> [q] =>
	(([q]) _ (#q)) ~
	lowerBound ~
	update

process : [q] _ q -> [q] _ q => newTails _ dec

run : [q] _ q -> [q] _ q => readCondition @ process

initialState : q -> [q] _ q => ($) ~ (makeTails _ q)

answer : [q] _ q -> q =>
	getRunTable ~
	(([q]) _ 9223372036854775807) ~
	lowerBound ~
	foundPosition

main : o -> q =>
	#q ~
	initialState ~
	run ~
	answer

main
