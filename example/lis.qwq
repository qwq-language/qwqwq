rangeCondition : [q]_q_(q_q) -> a_([q]_q_(q_q)) => ($) ~ (inRange_([q]_q_(q_q)))

midPlusOne : [q]_q_(q_q) -> q =>
        mid ~
        (q_1) ~
        ((q_q) + q)

boundsAfterLow : [q]_q_(q_q) -> q_q => ($) ~ (midPlusOne_getHigh)

boundsAfterHigh : [q]_q_(q_q) -> q_q => ($) ~ (getLow_mid)

setLow : [q]_q_(q_q) -> [q]_q_(q_q) => ($) ~ (getLeft_boundsAfterLow)

setHigh : [q]_q_(q_q) -> [q]_q_(q_q) => ($) ~ (getLeft_boundsAfterHigh)

