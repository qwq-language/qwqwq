getLow : [q]_q_(q_q) -> q => getRight ~ (q_(q : o))

getHigh : [q]_q_(q_q) -> q => getRight ~ ((q : o)_q)

mid : [q]_q_(q_q) -> q =>
        ($) ~
        (getLow_getHigh) ~
        ((q_q) + q) ~
        halve

probeInput : [q]_q_(q_q) -> [q]_q => ($) ~ (getTails_mid)

